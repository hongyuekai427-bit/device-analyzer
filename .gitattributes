# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files we want to always normalize and convert to native line endings on checkout.
*.js text
*.jsx text
*.ts text
*.tsx text
*.json text
*.md text
*.css text
*.html text
*.yml text
*.yaml text

# Declare files that will always be CRLF on checkout.
*.sln text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
